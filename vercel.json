{
  "version": 2,
  "name": "web2.0",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "djgamebox.com" }],
      "destination": "https://www.djgamebox.com/$1",
      "permanent": true
    }
  ]
}
